---
import Layout from '../layouts/Layout.astro';
import StudioScene from '../components/StudioScene.astro';
import { studioMediaReady } from '../lib/studio-media';
import Arrow from '../components/Arrow.astro';
import ContactCTA from '../components/ContactCTA.astro';
const faqs = [
 ['Cu ce tipuri de afaceri lucrați?', 'Cu afaceri care au o ofertă clară și vor să își dezvolte prezența digitală: servicii, comerț online sau branduri la început de drum. În prima conversație stabilim dacă suntem partenerul potrivit pentru obiectivele tale.'],
 ['Pot începe cu un singur serviciu?', 'Da. Putem începe cu Google Ads, un website sau identitatea de brand. Recomandăm ceea ce are sens pentru etapa în care se află afacerea ta, iar serviciile pot fi conectate ulterior.'],
 ['Cât costă un proiect?', 'Costul depinde de obiective, complexitate și livrabile. După ce înțelegem proiectul, primești o propunere cu etape și costuri clare. Bugetul pentru reclamele Google se stabilește separat de serviciul de administrare.'],
 ['În cât timp apar rezultatele din Google Ads?', 'Campaniile pot aduce trafic după activare, dar evaluarea și optimizarea au nevoie de date. Ritmul depinde de buget, competiție, ofertă și pagina de destinație. Stabilim obiective realiste și urmărim conversiile relevante.'],
 ['Website-ul va fi optimizat pentru Google?', 'Pregătim structura paginilor, metadatele, conținutul indexabil, sitemap-ul, datele structurate și performanța tehnică. Poziționarea depinde și de relevanță, competiție și autoritatea domeniului; nu promitem o anumită poziție.'],
];
const schema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))};
---
<Layout pageClass="studio-page" schema={schema}>
  <section class="studio-hero hero-scroll" aria-labelledby="hero-title">
    <div class="studio-viewport">
      <div class="studio-scene" aria-hidden="true">
        {studioMediaReady ? <><img src="/media/studio/hero-poster.webp" alt="" width="1280" height="720" fetchpriority="high" /><video id="hero-video" muted playsinline preload="none" data-src="/media/studio/hero.mp4" tabindex="-1"></video></> : <StudioScene />}
        <div class="studio-scene-wash"></div>
      </div>
      <div class="studio-opening">
        <div class="studio-kicker"><span class="red-dot"></span> L4G — INDEPENDENT DIGITAL STUDIO</div>
        <h1 id="hero-title"><span>Idei care</span><span class="title-last">ies din <em>cadru.</em><svg viewBox="0 0 120 120" class="title-star" aria-hidden="true"><path d="M60 0v120M0 60h120M18 18l84 84M18 102l84-84" /></svg></span></h1>
        <div class="opening-note"><span class="tiny-index">STRATEGIE / DESIGN / PERFORMANȚĂ</span><p>Facem loc brandului tău<br />într-o lume plină de zgomot.</p></div>
        <a class="studio-project-link" href="/contact/"><span>Ai o idee?<br /><strong>Hai s-o facem mare.</strong></span><span class="solid-arrow"><Arrow /></span></a>
      </div>
      <div class="scene-chapters" aria-hidden="true">
        <div class="scene-chapter" data-chapter="0"><span>01 / GOOGLE ADS</span><strong>Atrage.</strong><p>La locul potrivit.<br />În momentul potrivit.</p></div>
        <div class="scene-chapter" data-chapter="1"><span>02 / WEB DESIGN & DEVELOPMENT</span><strong>Convinge.</strong><p>O experiență clară.<br />Un pas firesc înainte.</p></div>
        <div class="scene-chapter" data-chapter="2"><span>03 / BRANDING</span><strong>Rămâne.</strong><p>În mintea oamenilor.<br />Prin ceea ce te face diferit.</p></div>
      </div>
      <div class="studio-bottom"><a href="#despre" class="enter-studio"><span class="down-arrow">↓</span> INTRĂ ÎN STUDIO <span class="scroll-word">/ SCROLL</span></a><div class="scene-counter" aria-hidden="true"><span id="scene-number">01</span><i></i><span>03</span></div><button class="motion-toggle" aria-pressed="true" aria-label="Mișcare ON: oprește animațiile">Mișcare <span>ON</span></button></div>
      <div class="hero-progress" aria-hidden="true"><span></span></div>
    </div>
  </section>

  <section class="studio-intro" id="despre" aria-labelledby="intro-title">
    <div class="section-rail"><span>01 / IDEILE AU NEVOIE DE DIRECȚIE</span><span>DESPRE NOI</span></div>
    <h2 id="intro-title" class="reveal">Un brand bun<br />nu încape într-o<br /><span class="intro-last">singură <em>disciplină.</em><span class="inline-badge" aria-hidden="true">L4G<br />STUDIO</span></span></h2>
    <div class="intro-detail"><span class="intro-spark" aria-hidden="true">+</span><p>De aceea, conectăm strategia, designul și performanța. Pentru o prezență digitală care nu doar arată bine, ci face lucrurile să se miște.</p><p>Suntem L4G. Gândim împreună imaginea, experiența și drumul până la client. De la prima idee la următoarea conversie.</p></div>
  </section>

  <section class="studio-services" id="servicii" aria-labelledby="services-title">
    <div class="services-heading"><div class="section-rail"><span>02 / CE PUNEM ÎN MIȘCARE</span><span>EXPERTIZĂ</span></div><div class="services-heading-row"><h2 id="services-title">Ambiție mare.<br /><em>Execuție pe măsură.</em></h2><p>Trei discipline.<br />O experiență conectată.</p></div></div>
    <div class="capability-stack">
      <article class="capability capability-ads" id="google-ads">
        <div class="capability-copy"><div class="capability-top"><span>01 — PERFORMANCE</span><span class="capability-symbol" aria-hidden="true"><Arrow /></span></div><h3>Click-ul<br />e doar<br /><em>începutul.</em></h3><p>Google Ads construit în jurul oamenilor care au nevoie de tine. Conectăm intenția, mesajul și pagina de destinație.</p><a class="capability-link" href="/servicii/google-ads/">Descoperă Google Ads <Arrow /></a><div class="capability-tags"><span>STRATEGIE</span><span>SEARCH & PERFORMANCE MAX</span><span>CONVERSII</span></div></div>
        <div class="capability-stage ads-stage" aria-label="Concept vizual despre vizibilitate și intenție de căutare">{studioMediaReady && <img src="/media/studio/detail-ads.webp" alt="Scenă de studio creativ cu decoruri de campanie" width="960" height="540" loading="lazy" decoding="async" />}<div class="stage-shade"></div><div class="ads-billboard" aria-hidden="true"><span>LA LOCUL POTRIVIT.</span><strong>HELLO,<br /><em>OPPORTUNITY.</em></strong><span class="billboard-sign">L4G / PERFORMANCE</span></div><div class="search-object" aria-hidden="true"><span class="search-glass"></span><span>Exact ce căutam.</span><i><Arrow /></i></div><span class="stage-caption">DE LA INTENȚIE LA ACȚIUNE</span></div>
      </article>
      <article class="capability capability-web" id="web-design">
        <div class="capability-copy"><div class="capability-top"><span>02 — DIGITAL EXPERIENCES</span><span class="capability-symbol" aria-hidden="true">+</span></div><h3>Nu doar<br />un website.<br /><em>O experiență.</em></h3><p>Design care atrage și development care îl susține. Rapid, intuitiv și construit în jurul următoarei acțiuni.</p><a class="capability-link" href="/servicii/web-design/">Descoperă Web Design & Dev <Arrow /></a><div class="capability-tags"><span>UX / UI</span><span>DEVELOPMENT</span><span>SEO TEHNIC</span></div></div>
        <div class="capability-stage web-stage" aria-label="Explorare vizuală de design web">{studioMediaReady && <img src="/media/studio/detail-web.webp" alt="Arhitectură și panouri grafice în studioul L4G" width="960" height="540" loading="lazy" decoding="async" />}<div class="stage-shade"></div><div class="browser-object" aria-hidden="true"><div class="browser-bar"><span>● ● ●</span><span>l4g / creative playground</span><span><Arrow /></span></div><div class="browser-content"><span class="browser-label">A DIFFERENT PERSPECTIVE</span><strong>Good design.<br /><em>Great feeling.</em></strong><div class="browser-art"><span></span><span></span><span></span></div><div class="browser-foot"><span>SCROLL TO DISCOVER</span><span>01 / 03</span></div></div></div><span class="stage-caption">FIECARE PIXEL ARE UN SCOP</span></div>
      </article>
      <article class="capability capability-brand" id="branding">
        <div class="capability-copy"><div class="capability-top"><span>03 — BRAND IDENTITIES</span><span class="capability-symbol" aria-hidden="true"><svg viewBox="0 0 100 100" aria-hidden="true"><path d="M50 0v100M0 50h100M15 15l70 70M15 85l70-70" /></svg></span></div><h3>Fă-te văzut.<br />Fă-te<br /><em>ținut minte.</em></h3><p>Poziționare, identitate și un limbaj propriu. Construim un brand coerent, de la primul semn până la ultima interacțiune.</p><a class="capability-link" href="/servicii/branding/">Descoperă Branding <Arrow /></a><div class="capability-tags"><span>STRATEGIE DE BRAND</span><span>IDENTITATE</span><span>DIRECȚIE CREATIVĂ</span></div></div>
        <div class="capability-stage brand-stage" aria-label="Explorare tipografică și cromatică a identității L4G">{studioMediaReady && <img src="/media/studio/detail-brand.webp" alt="Materiale de branding și compoziții grafice în studio" width="960" height="540" loading="lazy" decoding="async" />}<div class="stage-shade"></div><div class="brand-sheet sheet-back" aria-hidden="true"><span>L4G — COLOR STUDY</span><i></i><strong>Different.<br />By design.</strong></div><div class="brand-sheet sheet-front" aria-hidden="true"><span>IDENTITY / NO. 03</span><strong>Aa<span><svg viewBox="0 0 100 100" aria-hidden="true"><path d="M50 0v100M0 50h100M15 15l70 70M15 85l70-70" /></svg></span></strong><div><i></i><i></i><i></i></div><small>O PERSONALITATE. UN ÎNTREG SISTEM.</small></div><span class="stage-caption">O IDENTITATE CARE ÎȚI APARȚINE</span></div>
      </article>
    </div>
  </section>

  <section class="connection-lab" aria-labelledby="lab-title">
    <div class="section-rail"><span>03 / NU LUCRĂM ÎN SILOZURI</span><span>THE BIG PICTURE</span></div>
    <div class="lab-title"><h2 id="lab-title">Totul se<br /><em>leagă.</em></h2><p>Un click bun are nevoie de o pagină bună.<br />O pagină bună are nevoie de un brand clar.</p></div>
    <div class="lab-layout"><div class="lab-orbit"><svg class="lab-lines" viewBox="0 0 600 440" aria-hidden="true"><path d="M300 220 105 100M300 220 500 120M300 220 320 365" /></svg><div class="lab-center" aria-hidden="true">L4G<span>CONNECTED THINKING</span></div><button class="lab-node node-ads active" data-lab="ads" aria-pressed="true"><span>01</span>Google Ads <Arrow /></button><button class="lab-node node-web" data-lab="web" aria-pressed="false"><span>02</span>Web Design <Arrow /></button><button class="lab-node node-brand" data-lab="brand" aria-pressed="false"><span>03</span>Branding <Arrow /></button><span class="lab-hint">ALEGE O DISCIPLINĂ. VEZI CONEXIUNEA.</span></div><div class="lab-explanation" aria-live="polite"><span class="lab-index" id="lab-index">01 / GOOGLE ADS</span><h3 id="lab-heading">Aduci oamenii<br />potriviți.</h3><p id="lab-copy">Campaniile atrag atenția. Website-ul transformă interesul în acțiune, iar brandul dă un motiv să fii ales.</p><a id="lab-link" href="/servicii/google-ads/">Explorează serviciul <Arrow /></a></div></div>
  </section>

  <section class="studio-process" id="abordare" aria-labelledby="process-title"><div class="section-rail"><span>04 / DE LA „DACĂ” LA „GATA”</span><span>CUM LUCRĂM</span></div><div class="process-title"><h2 id="process-title">Ideile bune merită<br /><em>un plan bun.</em></h2><p>Tu aduci ambiția.<br />Noi venim cu întrebările potrivite.</p></div><div class="process-track"><article class="process-stop reveal"><div class="process-number">01<span>ÎNTÂI, ASCULTĂM.</span></div><h3>Descoperim.</h3><p>Înțelegem afacerea, oamenii și obiectivele. Stabilim direcția înainte să alegem forma.</p></article><article class="process-stop reveal"><div class="process-number">02<span>APOI, DĂM FORMĂ.</span></div><h3>Construim.</h3><p>Transformăm strategia în design, experiențe și campanii. Cu feedback clar, etapă cu etapă.</p></article><article class="process-stop reveal"><div class="process-number">03<span>ȘI CONTINUĂM.</span></div><h3>Îmbunătățim.</h3><p>Lansăm, urmărim ce se întâmplă și optimizăm. Datele ne arată următoarea mișcare.</p></article></div></section>

  <section class="studio-faq" aria-labelledby="faq-title"><div class="faq-heading"><span class="section-small-label">05 / FĂRĂ SEMNE DE ÎNTREBARE</span><h2 id="faq-title">Bine că<br />ai <em>întrebat.</em></h2><a href="mailto:contact@l4g.ro">Mai ai o întrebare? <Arrow /></a></div><div class="faq-list">{faqs.map(([question,answer])=><details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
  <ContactCTA />
</Layout>
