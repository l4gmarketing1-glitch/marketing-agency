---
import Layout from '../../layouts/Layout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
const services = [
 {slug:'google-ads', name:'Google Ads', title:'Google Ads cu strategie și focus pe conversii | L4G', description:'Campanii Google Ads construite în jurul obiectivelor tale. L4G conectează strategia, măsurarea conversiilor și optimizarea continuă.', eyebrow:'INTENȚIE. RELEVANȚĂ. ACȚIUNE.', headline:'Fii răspunsul.', accent:'La căutarea potrivită.', lead:'Conectăm oferta ta cu oamenii care caută exact ceea ce oferi. Cu o strategie clară, campanii bine construite și decizii bazate pe date.', intro:'Vizibilitate care are un scop.', body:'O campanie bună începe înainte de primul click. Înțelegem oferta, publicul și contextul competitiv, apoi alegem campaniile, mesajele și paginile de destinație care susțin obiectivele afacerii.', items:[['Strategie & audit','Analizăm contul existent sau construim direcția de la zero. Stabilim priorități și un buget realist.'],['Campanii relevante','Search, Shopping sau Performance Max, în funcție de ofertă, date disponibile și obiective.'],['Măsurarea conversiilor','Definim acțiunile care contează și pregătim măsurarea lor, cu respectarea preferințelor de consimțământ.'],['Optimizare continuă','Urmărim termenii de căutare, bugetele, mesajele și rezultatele. Testăm și ajustăm în mod transparent.']], note:'Bugetul media este separat de costul administrării. Stabilim împreună obiectivele și indicatorii relevanți; rezultatele depind de ofertă, piață și buget.'},
 {slug:'web-design', name:'Web Design & Development', title:'Web design și development pentru afacerea ta | L4G', description:'Website-uri rapide, responsive și ușor de folosit. L4G construiește experiențe digitale cu design distinct, structură SEO și atenție la conversii.', eyebrow:'PRIMA IMPRESIE. FIECARE INTERACȚIUNE.', headline:'Un website frumos.', accent:'Și bine gândit.', lead:'Construim experiențe digitale care exprimă brandul, explică oferta și fac următorul pas ușor. Pe orice ecran.', intro:'Design cu intenție. Cod cu grijă.', body:'Website-ul tău trebuie să fie mai mult decât o carte de vizită. Pornim de la ceea ce are nevoie vizitatorul, organizăm informația și creăm o experiență clară, rapidă și memorabilă.', items:[['Arhitectură & UX','Structurăm paginile în jurul serviciilor și întrebărilor clienților. Reducem pașii inutili către contact.'],['Design personalizat','O direcție vizuală adaptată brandului tău, cu tipografie, ritm și interacțiuni atent alese.'],['Development responsive','Implementare pentru mobil, tabletă și desktop, cu atenție la performanță, accesibilitate și întreținere.'],['SEO tehnic','Conținut indexabil, metadate, sitemap, structură semantică și date structurate relevante.']], note:'Stabilim înainte de implementare funcționalitățile, livrabilele și modul de administrare. Optimizarea tehnică pregătește site-ul pentru căutare; nu garantează o poziție în Google.'},
 {slug:'branding', name:'Branding', title:'Branding și identitate vizuală distinctă | L4G', description:'Construim branduri coerente și memorabile: poziționare, identitate vizuală, direcție creativă și ghid de brand. Descoperă abordarea L4G.', eyebrow:'CLAR ÎN MESAJ. DISTINCT ÎN EXPRESIE.', headline:'Mai mult decât un logo.', accent:'O identitate.', lead:'Dăm formă lucrurilor care te fac diferit. Pentru un brand pe care oamenii îl recunosc, îl înțeleg și îl țin minte.', intro:'Coerență la fiecare punct de contact.', body:'Brandingul începe cu esența afacerii: cui te adresezi, ce promiți și cum vrei să fii perceput. Transformăm această direcție într-un sistem vizual care funcționează în mediul digital și dincolo de el.', items:[['Poziționare','Clarificăm publicul, diferențiatorii și personalitatea brandului, înainte de a deschide prima planșă.'],['Identitate vizuală','Logo, paletă cromatică, tipografie și elemente grafice care spun aceeași poveste.'],['Direcție creativă','Stabilim expresia vizuală și verbală pentru website, campanii și materialele brandului.'],['Sistem & ghid de brand','Documentăm regulile și livrăm resursele necesare pentru a păstra identitatea consecventă.']], note:'Construim pe baza informațiilor reale despre afacerea ta. Conceptele sunt discutate și rafinate împreună, cu etape de feedback stabilite de la început.'}
];
export function getStaticPaths() {return [{params:{slug:'google-ads'}},{params:{slug:'web-design'}},{params:{slug:'branding'}}];}
const service=services.find(s=>s.slug===Astro.params.slug)!;
const schema={'@context':'https://schema.org','@type':'Service',name:service.name,description:service.description,provider:{'@id':'https://l4g.ro/#agency'},areaServed:{'@type':'Country',name:'România'},url:`https://l4g.ro/servicii/${service.slug}/`};
---
<Layout title={service.title} description={service.description} schema={schema}>
 <section class="inner-hero"><div class="breadcrumbs"><a href="/">Acasă</a><span>/</span><a href="/#servicii">Servicii</a><span>/</span><span>{service.name}</span></div><div class="eyebrow"><span class="status-dot"></span>{service.eyebrow}</div><h1>{service.headline}<br /><em>{service.accent}</em></h1><p class="lead">{service.lead}</p><a class="button button-lime" href={`/contact/?serviciu=${service.slug}`}>Discutăm despre {service.name.split(' &')[0]} <span><svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg></span></a></section>
 <section class="detail-section section-pad"><h2>{service.intro}</h2><div><p>{service.body}</p><ul class="deliverables">{service.items.map(([name,text])=><li><h3>{name}</h3><p>{text}</p></li>)}</ul><p class="service-note">{service.note}</p></div></section>
 <div class="related"><span>O EXPERIENȚĂ CONECTATĂ</span>{services.filter(s=>s.slug!==service.slug).map(s=><a href={`/servicii/${s.slug}/`}>{s.name} <svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg></a>)}</div>
 <ContactCTA />
</Layout>
